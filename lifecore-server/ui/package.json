{
  "name": "lifecore-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs --outdir dist",
    "watch": "node build.mjs --outdir dist --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "node --test 'src/**/*.test.ts'",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
